#!/usr/bin/env bash
# dotLab launcher
#   ./start              → browser chat
#   ./start --term       → terminal chat
#   ./start studio ...   → multi-agent studio
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
export PATH="$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"
# shellcheck disable=SC1091
[[ -f "$ROOT/config/ollama-env.sh" ]] && source "$ROOT/config/ollama-env.sh" || true
export OLLAMA_FLASH_ATTENTION="${OLLAMA_FLASH_ATTENTION:-1}"
export OLLAMA_KEEP_ALIVE="${OLLAMA_KEEP_ALIVE:-24h}"
export OLLAMA_NUM_PARALLEL="${OLLAMA_NUM_PARALLEL:-2}"
export OLLAMA_MAX_LOADED_MODELS="${OLLAMA_MAX_LOADED_MODELS:-3}"
export OLLAMA_KV_CACHE_TYPE="${OLLAMA_KV_CACHE_TYPE:-q8_0}"
export OLLAMA_NUM_BATCH="${OLLAMA_NUM_BATCH:-512}"

MODE="web"
AGENT_ARGS=()

if [[ $# -gt 0 ]]; then
  case "$1" in
    update|self-update)
      shift; exec python3 "$ROOT/bin/self-update.py" "$@" ;;
    scaffold)
      shift; exec python3 "$ROOT/bin/scaffold.py" "$@" ;;
    studio)
      shift; exec python3 "$ROOT/bin/studio.py" "$@" ;;
    playtest)
      shift; exec python3 "$ROOT/bin/playtest.py" "$@" ;;
    prefs)
      shift; exec python3 "$ROOT/bin/prefs.py" "$@" ;;
    turbo)
      shift; exec python3 "$ROOT/bin/turbo.py" "$@" ;;
    intervene|install-local|grok-local)
      shift; exec python3 "$ROOT/bin/intervene.py" "$@" ;;
    identity|whoami)
      shift; exec python3 "$ROOT/bin/identity.py" "$@" ;;
    patch|craft)
      shift; exec python3 "$ROOT/bin/patch.py" "$@" ;;
    live)
      shift; exec python3 "$ROOT/bin/live.py" "$@" ;;
    worlds|world|worldclaw)
      shift; exec python3 "$ROOT/bin/worlds.py" "$@" ;;
    github|gh)
      shift; exec python3 "$ROOT/bin/github.py" "$@" ;;
    wiki)
      shift; exec python3 "$ROOT/bin/wiki.py" "$@" ;;
    kit)
      shift; exec python3 "$ROOT/bin/kit.py" "$@" ;;
    verify|score)
      shift; exec python3 "$ROOT/bin/verify.py" "$@" ;;
    quality)
      shift; exec python3 "$ROOT/bin/quality.py" "$@" ;;
    rag)
      shift; exec python3 "$ROOT/bin/rag.py" "$@" ;;
    slots)
      shift; exec python3 "$ROOT/bin/slots.py" "$@" ;;
    golden|ci-golden)
      shift; exec python3 "$ROOT/bin/golden.py" "$@" ;;
    antislope|anti-slop)
      shift; exec python3 "$ROOT/bin/antislope.py" "$@" ;;
    eval-briefs|eval)
      shift; exec python3 "$ROOT/bin/eval_briefs.py" "$@" ;;
    engine)
      shift; exec python3 "$ROOT/bin/engine_ops.py" "$@" ;;
    ship)
      shift; exec python3 "$ROOT/bin/github.py" ship "$@" ;;
    cloud)
      shift; exec python3 "$ROOT/bin/cloud.py" "$@" ;;
  esac
fi

for a in "$@"; do
  case "$a" in
    --term|-t|term|terminal) MODE="term" ;;
    --web|-w) MODE="web" ;;
    --agent) MODE="agent" ;;
    -h|--help)
      echo "Usage: ./start | ./start --term | ./start studio build -p DIR 'brief'"
      echo "       ./start turbo warmup | ./start scaffold web-game --genre runner"
      echo "       ./start worlds generate -p DIR 'biomes' | ./start verify -p DIR"
      exit 0
      ;;
    *) AGENT_ARGS+=("$a") ;;
  esac
done

if ! curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
  if [[ "$(uname)" == "Darwin" ]]; then
    open -a Ollama 2>/dev/null || true
  fi
  for _ in {1..40}; do
    curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && break
    sleep 0.35
  done
fi

if ! curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
  if [[ "$(uname)" == "Darwin" ]]; then
    osascript -e 'display alert "dotLab" message "Ollama is not running.\nOpen Ollama.app, then try again." as critical' 2>/dev/null || true
  fi
  echo "❌ Ollama not running. https://ollama.com"
  exit 1
fi

# Accept dotlab OR legacy gamemaster. Create free aliases if only legacy exists.
if ! ollama list 2>/dev/null | awk '{print $1}' | grep -qE '^(dotlab|gamemaster)(:|$)'; then
  echo "→ Model missing — installing MAX profile…"
  "$ROOT/install.sh" --max
else
  # Rebrand: map gamemaster* → dotlab* without re-downloading weights
  echo "→ Ensuring dotLab model tags…"
  PYTHONPATH="$ROOT/bin${PYTHONPATH:+:$PYTHONPATH}" python3 -c \
    'from gmcommon import ensure_product_models; ensure_product_models()' \
    || true
fi

if [[ "$MODE" == "term" ]]; then
  exec "$ROOT/bin/dotlab"
fi

if [[ "$MODE" == "agent" ]]; then
  exec python3 "$ROOT/bin/agent.py" "${AGENT_ARGS[@]}"
fi

PORT="${GAMEMASTER_PORT:-8765}"
# A previous double-click leaves python on :8765. Reusing it exits this
# script (Terminal then runs `; exit` and the window vanishes) and the
# browser talks to stale code. Always take the port back.
if command -v lsof >/dev/null 2>&1; then
  pids="$(lsof -nP -t -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true)"
  if [[ -n "${pids}" ]]; then
    echo "↻ Replacing process on :$PORT"
    # shellcheck disable=SC2086
    kill ${pids} 2>/dev/null || true
    sleep 0.4
    pids="$(lsof -nP -t -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true)"
    if [[ -n "${pids}" ]]; then
      # shellcheck disable=SC2086
      kill -9 ${pids} 2>/dev/null || true
      sleep 0.2
    fi
  fi
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    PORT=$((PORT + 1))
    export GAMEMASTER_PORT="$PORT"
    echo "↻ :8765 still busy — using :$PORT"
  fi
fi

# Background dual-model warmup (flash+max) — does not block dashboard
(
  PYTHONPATH="$ROOT/bin${PYTHONPATH:+:$PYTHONPATH}" python3 -c \
    'from quality import ensure_dual_warmup; ensure_dual_warmup(force=False)' \
    >/dev/null 2>&1 || true
) &

echo "→ Chat http://127.0.0.1:${PORT}/  (leave this window open)"
exec /usr/bin/env python3 "$ROOT/bin/server.py"
